#!/usr/bin/expect -f
set timeout -1
set password "Prasath@1990"
set host "103.191.208.98"
set user "root"

spawn ssh -o StrictHostKeyChecking=no $user@$host "fuser -k 3005/tcp; pm2 restart vamsi-frontend; sleep 5; pm2 logs vamsi-frontend --lines 20"
expect {
    "password:" { send "$password\r"; exp_continue }
    eof
}
