#!/usr/bin/expect -f
set timeout -1
set password "Prasath@1990"
set host "103.191.208.98"
set user "root"

spawn ssh -o StrictHostKeyChecking=no $user@$host "cd /var/www/vamsicrackers/frontend && pm2 delete vamsi-frontend && pm2 start npm --name \"vamsi-frontend\" -- start -- -p 3005 && pm2 save"
