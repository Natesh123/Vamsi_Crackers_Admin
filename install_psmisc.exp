#!/usr/bin/expect -f
set timeout -1
set password "Prasath@1990"
set host "103.191.208.98"
set user "root"

spawn ssh -o StrictHostKeyChecking=no $user@$host "apt-get update && apt-get install -y psmisc && fuser -k 3005/tcp; pm2 restart vamsi-frontend"
expect {
    "password:" { send "$password\r"; exp_continue }
    eof
}
