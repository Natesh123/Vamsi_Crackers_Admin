#!/usr/bin/expect -f
set timeout -1
set password "Prasath@1990"
set host "103.191.208.98"
set user "root"

spawn ssh -o StrictHostKeyChecking=no $user@$host "kill -9 \$(lsof -t -i:3000); pm2 restart vamsi-frontend; sleep 5; pm2 logs vamsi-frontend --lines 20"
expect {
    "password:" { send "$password\r"; exp_continue }
    eof
}
